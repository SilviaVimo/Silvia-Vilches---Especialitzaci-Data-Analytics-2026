MEDIDAS GRAFICOS RFM/SEGMENTOS

Clientes RFM = COUNTROWS (RFM)

% Clientes RFM =
DIVIDE ( [Clientes RFM], CALCULATE ([Clientes RFM], ALL ( RFM[segmento])))

% Ventas RFM =
DIVIDE ([Ventas], CALCULATE ([Ventas], ALL (RFM[segmento])))

Valor medio cliente = AVERAGE (RFM[valor_monetario])




MEDIDAS GRAFICOS ESTANDARIZADOS DATOS
% Clientes grupo k5 =
DIVIDE ( COUNTROWS (RFM), CALCULATE (COUNTROWS ( RFM), ALL (RFM[cluster_estandarizado])))

% Ventas grupo k5 =
DIVIDE ( [Ventas], CALCULATE ( [Ventas], ALL (RFM[cluster_estandarizado])))

% del grupo =
