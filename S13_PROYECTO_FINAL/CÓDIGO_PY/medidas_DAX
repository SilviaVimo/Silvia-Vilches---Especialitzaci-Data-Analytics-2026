MEDIDAS GRAFICOS K-MEANS
% Clientes k4 =
DIVIDE ( COUNTROWS (RFM), CALCULATE ( COUNTROWS (RFM), ALL (RFM[cluster_nombre])))

% Ventas k4 =
DIVIDE ([Ventas], CALCULATE ([Ventas], ALL (RFM[cluster_nombre])))

% Clientes élite + crecimiento =
CALCULATE ( [% Clientes k4], RFM[cluster_nombre] IN {"Viajeros de élite", "Viajeros en crecimiento" } )

% Ventas élite + crecimiento =
CALCULATE ([% Ventas k4], RFM[cluster_nombre] IN {"Viajeros de élite", "Viajeros en crecimiento"})


